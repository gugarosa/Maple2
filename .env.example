# Maple2.File.Ingest

# Local (non-Docker) path to your MapleStory2 Data folder.
MS2_DATA_FOLDER=D:\MapleStory\MapleStory2\client\Data

# Docker host path mounted at /ClientData for the explicit file-ingest command.
MS2_DOCKER_DATA_FOLDER=D:\MapleStory\MapleStory2\client\Data

# Primary language. Mainly used for searching on black market, commands, etc.
# EN, KR, CN, JP, DE, PR
LANGUAGE=EN

# Database connection
DB_IP=localhost
DB_PORT=3306
DB_USER=root
# Required. Replace this before starting MySQL.
DB_PASSWORD=

DATA_DB_NAME=maple-data
GAME_DB_NAME=game-server

# For an existing installation, preserve its Compose project name to reuse its volume.
# COMPOSE_PROJECT_NAME=maple2

# Maple2.Server - Only needed if hosting for external access
CONFIG_PATH=./config.yaml
CLIENT_BIND_IP=127.0.0.1
GAME_IP=127.0.0.1
LOGIN_IP=127.0.0.1

GRPC_GAME_IP=127.0.0.1
GRPC_WORLD_IP=127.0.0.1
GRPC_WORLD_PORT=21001
GRPC_LOGIN_IP=127.0.0.1

WEB_IP=127.0.0.1
WEB_PORT=4000

# Optional reverse-proxy listener; WEB_PORT remains the native client's public HTTP port.
# WEB_BIND_PORT=4001
# Enable only behind the trusted loopback HTTPS proxy.
# REQUIRE_HTTPS_REGISTRATION=true
# Exact corresponding source for a deployed server snapshot.
# SERVER_SOURCE_URL=https://play.ms2.example.org/source/server-source.tar.gz
# Optional player-facing setup page linked from registration; HTTPS, no credentials.
# PLAYER_WEBSITE_URL=https://ms2.example.org/#getting-started
