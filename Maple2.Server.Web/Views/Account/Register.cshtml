@using System.Linq
@using Maple2.Server.Web.Helpers
@model Maple2.Server.Web.Model.RegistrationForm
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = Model.RegisteredUsername != null ? "Account created" : "Create an account";
    string? playerWebsiteUrl = Environment.GetEnvironmentVariable("PLAYER_WEBSITE_URL");
    string? FieldId(string key) => key[(key.LastIndexOf('.') + 1)..].ToLowerInvariant() switch {
        "username" => "username",
        "password" => "password",
        "confirmpassword" => "confirm-password",
        _ => null,
    };
    var errors = ViewData.ModelState.SelectMany(entry => entry.Value!.Errors.Select(error => new {
        Field = FieldId(entry.Key),
        Message = string.IsNullOrWhiteSpace(error.ErrorMessage)
            ? "Check your details and try again."
            : error.ErrorMessage,
    })).OrderBy(error => error.Field switch {
        "username" => 1,
        "password" => 2,
        "confirm-password" => 3,
        _ => 0,
    }).ToArray();
    var usernameErrors = errors.Where(error => error.Field == "username").ToArray();
    var passwordErrors = errors.Where(error => error.Field == "password").ToArray();
    var confirmErrors = errors.Where(error => error.Field == "confirm-password").ToArray();
}
@if (Model.RegisteredUsername != null) {
    <h1>Your MS2 account is ready</h1>
    <p class="account-success" role="status">Account <strong><bdi>@Model.RegisteredUsername</bdi></strong> has been created.</p>
    <p class="account-intro">Next, set up your compatible client. Sign in to the game with this username and the password you chose.</p>
    @if (playerWebsiteUrl != null) {
        <a class="button account-primary" href="@playerWebsiteUrl">Continue to client setup</a>
    } else {
        <p>In Mushroom, select Login host <code>@Maple2.Server.Core.Constants.Target.LoginIp</code> and port <code>@Maple2.Server.Core.Constants.Target.LoginPort</code>. Leave automatic login off, launch your compatible client, and sign in to the game.</p>
        <p class="note">Ask your server operator for the client setup guide if you need help connecting.</p>
    }
    <p class="note">This is an ordinary player account, without administrator access. Existing characters remain attached to their existing accounts.</p>
    <a class="text-link" href="@Url.Content("~/account")">Register another account</a>
} else {
    <h1 id="registration-title">Create your MS2 account</h1>
    <p class="account-intro">Use these credentials to sign in to the game. MS1 accounts and characters do not carry over.</p>
    <p class="note">Registration and play are for invited testers on approved networks.</p>
    @if (!ViewData.ModelState.IsValid) {
        <section class="feedback" role="alert" id="registration-errors" aria-labelledby="registration-errors-title" tabindex="-1" autofocus>
            <h2 id="registration-errors-title">@(Context.Response.StatusCode == 503 ? "Registration is temporarily unavailable" : "Check your registration details")</h2>
            <ul>
                @foreach (var error in errors) {
                    <li>
                        @if (error.Field != null) {
                            string label = error.Field switch {
                                "username" => "Username",
                                "password" => "Password",
                                _ => "Confirm password",
                            };
                            <a href="#@error.Field">@label: @error.Message</a>
                        } else {
                            @error.Message
                        }
                    </li>
                }
            </ul>
            <p>Your username is kept below. Re-enter both password fields before trying again.</p>
        </section>
    }
    <form class="account-form" method="post" action="@Url.Content("~/account/register")" aria-labelledby="registration-title" aria-describedby="registration-help">
        @Html.AntiForgeryToken()
        <p class="note form-requirement">All fields are required.</p>
        <div class="field">
            <label for="username">Username</label>
            <input id="username" name="Username" value="@Model.Username" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]{3,24}" required aria-invalid="@(usernameErrors.Length > 0 ? "true" : null)" aria-describedby="@(usernameErrors.Length > 0 ? "username-help username-error" : "username-help")" />
            <small id="username-help">@RegistrationResponses.USERNAME_REQUIREMENT Usernames are not case-sensitive.</small>
            @if (usernameErrors.Length > 0) {
                <p class="field-error" id="username-error">
                    @foreach (var error in usernameErrors) {
                        <span>Error: @error.Message</span>
                    }
                </p>
            }
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input id="password" name="Password" type="password" autocomplete="new-password" minlength="8" maxlength="16" required aria-invalid="@(passwordErrors.Length > 0 ? "true" : null)" aria-describedby="@(passwordErrors.Length > 0 ? "password-help password-error" : "password-help")" />
            <small id="password-help">8-16 characters. The game client's password field accepts at most 16 characters.</small>
            @if (passwordErrors.Length > 0) {
                <p class="field-error" id="password-error">
                    @foreach (var error in passwordErrors) {
                        <span>Error: @error.Message</span>
                    }
                </p>
            }
        </div>
        <div class="field">
            <label for="confirm-password">Confirm password</label>
            <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="16" required aria-invalid="@(confirmErrors.Length > 0 ? "true" : null)" aria-describedby="@(confirmErrors.Length > 0 ? "confirm-password-error" : null)" />
            @if (confirmErrors.Length > 0) {
                <p class="field-error" id="confirm-password-error">
                    @foreach (var error in confirmErrors) {
                        <span>Error: @error.Message</span>
                    }
                </p>
            }
        </div>
        <button class="button account-primary" type="submit">Create account</button>
    </form>
    <p class="note" id="registration-help">Already registered? Sign in with your existing credentials in the game client. Creating another account does not recover an existing one.</p>
    @if (!Context.Request.IsHttps) {
        <p class="note">Use this HTTP page only on your own computer or trusted local network. Public servers must provide HTTPS for registration.</p>
    }
}
